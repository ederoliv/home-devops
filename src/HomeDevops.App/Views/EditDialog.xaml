<Window x:Class="HomeDevops.Views.EditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:HomeDevops.Views"
        Title="{Binding Title}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico"
        Style="{DynamicResource AppWindow}">

    <StackPanel Margin="22">
        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />

        <TextBlock Text="{Binding NameLabel}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowImage, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="Logo" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal">
                <Border Width="56" Height="56"
                        CornerRadius="10"
                        Background="{DynamicResource BgBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1">
                    <Rectangle RadiusX="9" RadiusY="9"
                               Visibility="{Binding Image, Converter={StaticResource HasValueToVisible}}">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding Image, Converter={StaticResource DataUrlToImage}}"
                                        Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>
                <Button Content="Escolher imagem" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding ChooseImageCommand}" />
                <Button Content="Remover" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding RemoveImageCommand}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Descrição" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4" />
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 Height="84"
                 Margin="0,0,0,12" />

        <CheckBox Content="Criar tarefa padrão com o mesmo nome"
                  IsChecked="{Binding CreateDefaultTask}"
                  Margin="0,0,0,12"
                  Visibility="{Binding ShowDefaultTask, Converter={StaticResource BoolToVisible}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button Content="Salvar"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    Margin="8,0,0,0"
                    IsEnabled="{Binding CanSave}"
                    Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
