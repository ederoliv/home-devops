<Window x:Class="HomeDevops.Views.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Heading}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico"
        Style="{DynamicResource AppWindow}">

    <StackPanel Margin="22">
        <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitle}" />

        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock Text="{Binding Prompt}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4" />
        <Border Background="{DynamicResource Panel2Brush}" Padding="8,4" Margin="0,0,0,8" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>
        <TextBox x:Name="TypedBox" Text="{Binding Typed, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Cancelar" IsCancel="True" />
            <Button Content="Excluir"
                    IsDefault="True"
                    Style="{StaticResource DangerButton}"
                    Margin="8,0,0,0"
                    IsEnabled="{Binding CanConfirm}"
                    Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
