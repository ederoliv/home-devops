<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms só para o seletor de cor (System.Windows.Forms.ColorDialog); o WPF não tem um -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HomeDevops</AssemblyName>
    <RootNamespace>HomeDevops</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- evita ambiguidade entre os tipos do WPF e do WinForms -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="..\HomeDevops.Core\HomeDevops.Core.csproj" />
  </ItemGroup>

</Project>
